{
  "name": "Room Lab (Bun 1.3.14)",
  "build": {
    "dockerfile": "../Dockerfile",
    "target": "dev",
    "args": { "BUN_VERSION": "1.3.14" }
  },
  "workspaceFolder": "/workspaces/habbo-clone",
  "forwardPorts": [5173, 3001],
  "containerEnv": {
    "CHROMIUM_PATH": "/usr/bin/chromium",
    "ROOMLAB_DB": "/workspaces/habbo-clone/data/dev.sqlite",
    "PORT": "3001",
    "TRUST_PROXY": "0"
  },
  "postCreateCommand": "bun install --frozen-lockfile",
  "remoteUser": "bun"
}
